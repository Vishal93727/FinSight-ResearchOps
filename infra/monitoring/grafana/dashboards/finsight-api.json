{
  "title": "FinSight ResearchOps API",
  "uid": "finsight-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP requests / second", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (route) (rate(finsight_http_requests_total[5m]))", "legendFormat": "{{route}}"}]},
    {"id": 2, "type": "timeseries", "title": "P95 request latency", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(finsight_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}]},
    {"id": 3, "type": "timeseries", "title": "HTTP 5xx responses / second", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}, "targets": [{"expr": "sum(rate(finsight_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx"}]}
  ],
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser"
}
