# Copy this file to .env and replace every placeholder before running Compose.
APP_ENV=local
APP_NAME=FinSight ResearchOps API
API_VERSION=0.1.0
DEBUG=false
ALLOW_SELF_REGISTRATION=true
CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_USER=finsight
POSTGRES_DB=finsight
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql+psycopg://finsight:replace-with-a-long-random-local-password@postgres:5432/finsight
REDIS_URL=redis://redis:6379/0

# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# Replace with a monitored contact email before SEC requests.
SEC_EDGAR_USER_AGENT=FinSightResearchOps admin@example.com
DATA_STORAGE_PATH=./data
MAX_INGESTION_ROWS=100000
MAX_DOCUMENT_UPLOAD_BYTES=15728640
DOCUMENT_CHUNK_SIZE=420
DOCUMENT_CHUNK_OVERLAP=60
DOCUMENT_EMBEDDING_DIMENSIONS=384
MAX_DOCUMENT_CHUNKS=10000
MAX_ML_EVALUATION_ROWS=100000
LOG_LEVEL=INFO
VITE_API_BASE_URL=/api/v1

# Experiment tracking: local JSON by default; optional MLflow backend
EXPERIMENT_TRACKING_BACKEND=local
# MLFLOW_TRACKING_URI=http://localhost:5000

# Deterministic offline embedding by default. Use sentence_transformers only after caching model weights.
DOCUMENT_EMBEDDING_PROVIDER=feature_hash_v1
DOCUMENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCUMENT_VECTOR_BACKEND=json
DOCUMENT_RERANKER=none
DOCUMENT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# deterministic is the offline default; select langgraph after installing the research-ai extra.
RESEARCH_WORKFLOW_ENGINE=deterministic
RESEARCH_SYNTHESIS_PROVIDER=extractive
RESEARCH_LLM_MODEL=gpt-4.1-mini
# Optional LLM key: set OPENAI_API_KEY only when using langchain_openai; never commit it.

# Docker build extras. Add rl to enable PPO/SAC workers; add semantic,research-ai,finbert only when needed.
# Example for Phase 4 training: PYTHON_EXTRAS=ml,pdf,rl
PYTHON_EXTRAS=ml,pdf,observability

# Observability (Grafana password must be changed before deployment)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-long-grafana-password
OTEL_SERVICE_NAME=finsight-researchops-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# For optional PPO/SAC workers, set PYTHON_EXTRAS=ml,pdf,rl,observability
